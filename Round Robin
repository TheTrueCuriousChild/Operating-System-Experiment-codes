#include <stdio.h>

// Structure to store process information
struct Process {
    int id;               // Process ID
    int arrival;          // Arrival Time
    int burst;            // Original Burst Time
    int remaining_burst;  // Remaining Burst Time
    int waiting;          // Waiting Time
    int turnaround;       // Turnaround Time
    int completion;       // Completion Time
};

void main() {
    int n, i, time_quantum;
    float avg_waiting = 0, avg_turnaround = 0;
    
    printf("Enter the number of processes: ");
    scanf("%d", &n);
    
    printf("Enter time quantum: ");
    scanf("%d", &time_quantum);
    
    struct Process p[n];
    
    // Input process details
    for(i = 0; i < n; i++) {
        p[i].id = i+1;
        printf("Enter arrival time for Process P%d: ", i+1);
        scanf("%d", &p[i].arrival);
        printf("Enter burst time for Process P%d: ", i+1);
        scanf("%d", &p[i].burst);
        p[i].remaining_burst = p[i].burst;
    }
    
    int completed_processes = 0;
    int current_time = 0;
    int gantt_chart[100];  // For storing the order of processes
    int gantt_time[100];   // For storing time points
    int gantt_index = 0;
    
    // Create a ready queue
    int queue[100];
    int front = 0, rear = 0;
    
    // Find the first process to arrive
    int first_arrival = 9999;
    for(i = 0; i < n; i++) {
        if(p[i].arrival < first_arrival) {
            first_arrival = p[i].arrival;
        }
    }
    
    current_time = first_arrival;
    
    // Add first processes to queue
    for(i = 0; i < n; i++) {
        if(p[i].arrival <= current_time) {
            queue[rear] = i;
            rear++;
        }
    }
    
    // Process scheduling
    while(completed_processes < n) {
        // If queue is empty, find the next process to arrive
        if(front == rear) {
            int next_arrival = 9999;
            int next_process = -1;
            
            for(i = 0; i < n; i++) {
                if(p[i].remaining_burst > 0 && p[i].arrival < next_arrival && p[i].arrival > current_time) {
                    next_arrival = p[i].arrival;
                    next_process = i;
                }
            }
            
            if(next_process != -1) {
                current_time = next_arrival;
                queue[rear] = next_process;
                rear++;
            } else {
                break;  // No more processes to execute
            }
        }
        
        // Get the next process from queue
        int current_process = queue[front];
        front++;
        
        // Record for Gantt chart
        gantt_chart[gantt_index] = p[current_process].id;
        gantt_time[gantt_index] = current_time;
        gantt_index++;
        
        // Execute for time quantum or remaining time
        int execute_time = (p[current_process].remaining_burst < time_quantum) ? 
                          p[current_process].remaining_burst : time_quantum;
        
        current_time += execute_time;
        p[current_process].remaining_burst -= execute_time;
        
        // Check for new arrivals during this time quantum
        for(i = 0; i < n; i++) {
            if(p[i].arrival > gantt_time[gantt_index-1] && p[i].arrival <= current_time && p[i].remaining_burst > 0) {
                queue[rear] = i;
                rear++;
            }
        }
        
        // If process is not completed, add back to queue
        if(p[current_process].remaining_burst > 0) {
            queue[rear] = current_process;
            rear++;
        } else {
            // Process is completed
            completed_processes++;
            p[current_process].completion = current_time;
            p[current_process].turnaround = p[current_process].completion - p[current_process].arrival;
            p[current_process].waiting = p[current_process].turnaround - p[current_process].burst;
            
            avg_waiting += p[current_process].waiting;
            avg_turnaround += p[current_process].turnaround;
        }
    }
    
    // Add final time point for Gantt chart
    gantt_time[gantt_index] = current_time;
    
    // Calculate averages
    avg_waiting /= n;
    avg_turnaround /= n;
    
    // Display results
    printf("\nRound Robin Scheduling (Time Quantum = %d):\n", time_quantum);
    printf("Process\tArrival\tBurst\tWaiting\tTurnaround\tCompletion\n");
    
    for(i = 0; i < n; i++) {
        printf("P%d\t%d\t%d\t%d\t%d\t\t%d\n", p[i].id, p[i].arrival, p[i].burst, p[i].waiting, p[i].turnaround, p[i].completion);
    }
    
    printf("\nAverage Waiting Time: %.2f\n", avg_waiting);
    printf("Average Turnaround Time: %.2f\n", avg_turnaround);
    
    // Display Gantt Chart
    printf("\nGantt Chart:\n");
    printf("| ");
    for(i = 0; i < gantt_index; i++) {
        printf("P%d | ", gantt_chart[i]);
    }
    
    printf("\n");
    for(i = 0; i <= gantt_index; i++) {
        printf("%d    ", gantt_time[i]);
    }
    printf("\n");
}
