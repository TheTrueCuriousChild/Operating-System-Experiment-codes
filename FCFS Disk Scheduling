#include <stdio.h>
#include <stdlib.h>

#define MAX_REQUESTS 100

void main() {
    int requests[MAX_REQUESTS];
    int n, head, i;
    int total_seek_time = 0;
    
    printf("Enter the number of disk requests: ");
    scanf("%d", &n);
    
    printf("Enter the disk request sequence: ");
    for(i = 0; i < n; i++) {
        scanf("%d", &requests[i]);
    }
    
    printf("Enter the initial position of head: ");
    scanf("%d", &head);
    
    printf("\nFCFS Disk Scheduling Algorithm\n");
    printf("Seek Sequence: %d", head);
    
    // Calculate total seek time
    for(i = 0; i < n; i++) {
        total_seek_time += abs(requests[i] - head);
        head = requests[i];
        printf(" -> %d", head);
    }
    
    printf("\nTotal Seek Time: %d\n", total_seek_time);
    printf("Average Seek Time: %.2f\n", (float)total_seek_time / n);
    
    // Display graphical representation (optional)
    printf("\nGraphical Representation:\n");
    
    int max_track = 0;
    for(i = 0; i < n; i++) {
        if(requests[i] > max_track) {
            max_track = requests[i];
        }
    }
    
    // Set max_track to at least 100 for better visualization
    if(max_track < 100) {
        max_track = 100;
    }
    
    head = requests[0]; // Reset head to initial position
    
    // Draw the seek operations
    printf("Initial head position: %d\n", head);
    
    for(i = 0; i < n; i++) {
        int distance = abs(requests[i] - head);
        
        printf("Move from %d to %d, Seek distance: %d\n", head, requests[i], distance);
        
        // Visual representation (simple)
        int min_pos = (head < requests[i]) ? head : requests[i];
        int max_pos = (head > requests[i]) ? head : requests[i];
        
        printf("  ");
        for(int j = 0; j <= max_track/10; j++) {
            if(j == min_pos/10) printf("<");
            else if(j == max_pos/10) printf(">");
            else if(j > min_pos/10 && j < max_pos/10) printf("-");
            else printf(" ");
        }
        printf("\n");
        
        head = requests[i];
    }
}
