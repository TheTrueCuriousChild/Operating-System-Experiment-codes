// This version of disk scheduling doesn't take input form the user.

#include<stdio.h>
#include<conio.h>
#include<math.h>
//FCFS Disk scheduling Program.
//The fcfs function
void fcfs_disk(int request[],int n,int initial_position)
{
    int i,sum=0;
    printf("The track difference sequnentially would be\n");
    for(i=0;i<n;i++)
    {
       printf("%d\n",abs(initial_position-request[i]));
       sum+=abs(initial_position-request[i]);
       initial_position=request[i];
    }
    printf("\nThe total movent is \n%d",sum);
}
//Writing the main function
void main()
{
    int request[]={10,20,15,25,30};
    fcfs_disk(request,5,5);
}
