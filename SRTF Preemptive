#include <stdio.h>

// Structure to store process information
struct Process {
    int id;               // Process ID
    int arrival;          // Arrival Time
    int burst;            // Original Burst Time
    int remaining_burst;  // Remaining Burst Time
    int waiting;          // Waiting Time
    int turnaround;       // Turnaround Time
    int completion;       // Completion Time
};

void main() {
    int n, i, j;
    float avg_waiting = 0, avg_turnaround = 0;
    
    printf("Enter the number of processes: ");
    scanf("%d", &n);
    
    struct Process p[n];
    
    // Input process details
    for(i = 0; i < n; i++) {
        p[i].id = i+1;
        printf("Enter arrival time for Process P%d: ", i+1);
        scanf("%d", &p[i].arrival);
        printf("Enter burst time for Process P%d: ", i+1);
        scanf("%d", &p[i].burst);
        p[i].remaining_burst = p[i].burst;
    }
    
    int completed_processes = 0;
    int current_time = 0;
    int shortest_remaining = 0;
    int gantt_chart[100];  // For storing the order of processes
    int gantt_time[100];   // For storing time points
    int gantt_index = 0;
    int prev_process = -1;
    
    // Process scheduling
    while(completed_processes < n) {
        // Find process with minimum remaining time
        shortest_remaining = -1;
        int min_burst = 9999;
        
        for(i = 0; i < n; i++) {
            if(p[i].arrival <= current_time && p[i].remaining_burst > 0) {
                if(p[i].remaining_burst < min_burst) {
                    min_burst = p[i].remaining_burst;
                    shortest_remaining = i;
                }
            }
        }
        
        // If no process is found, increment time
        if(shortest_remaining == -1) {
            current_time++;
            continue;
        }
        
        // Record for Gantt chart if process changed
        if(prev_process != shortest_remaining) {
            gantt_chart[gantt_index] = p[shortest_remaining].id;
            gantt_time[gantt_index] = current_time;
            gantt_index++;
            prev_process = shortest_remaining;
        }
        
        // Reduce remaining time by 1
        p[shortest_remaining].remaining_burst--;
        current_time++;
        
        // If the process is completed
        if(p[shortest_remaining].remaining_burst == 0) {
            completed_processes++;
            p[shortest_remaining].completion = current_time;
            p[shortest_remaining].turnaround = p[shortest_remaining].completion - p[shortest_remaining].arrival;
            p[shortest_remaining].waiting = p[shortest_remaining].turnaround - p[shortest_remaining].burst;
            
            avg_waiting += p[shortest_remaining].waiting;
            avg_turnaround += p[shortest_remaining].turnaround;
        }
    }
    
    // Add final time point for Gantt chart
    gantt_time[gantt_index] = current_time;
    
    // Calculate averages
    avg_waiting /= n;
    avg_turnaround /= n;
    
    // Display results
    printf("\nSRTF Preemptive Scheduling:\n");
    printf("Process\tArrival\tBurst\tWaiting\tTurnaround\tCompletion\n");
    
    for(i = 0; i < n; i++) {
        printf("P%d\t%d\t%d\t%d\t%d\t\t%d\n", p[i].id, p[i].arrival, p[i].burst, p[i].waiting, p[i].turnaround, p[i].completion);
    }
    
    printf("\nAverage Waiting Time: %.2f\n", avg_waiting);
    printf("Average Turnaround Time: %.2f\n", avg_turnaround);
    
    // Display Gantt Chart
    printf("\nGantt Chart:\n");
    printf("| ");
    for(i = 0; i < gantt_index; i++) {
        printf("P%d | ", gantt_chart[i]);
    }
    
    printf("\n");
    for(i = 0; i <= gantt_index; i++) {
        printf("%d    ", gantt_time[i]);
    }
    printf("\n");
}
