#include <stdio.h>

#define MAX_BLOCKS 100

// Structure for memory block
struct MemoryBlock {
    int id;             // Block ID
    int size;           // Size of block
    int allocated;      // 0 for free, 1 for allocated
    int process_id;     // ID of process that allocated the block (-1 if free)
};

void main() {
    struct MemoryBlock memory[MAX_BLOCKS];
    int n, m, i, j;
    
    printf("Enter the number of memory blocks: ");
    scanf("%d", &n);
    
    // Input memory block sizes
    for(i = 0; i < n; i++) {
        printf("Enter size of memory block %d: ", i+1);
        scanf("%d", &memory[i].size);
        memory[i].id = i+1;
        memory[i].allocated = 0;
        memory[i].process_id = -1;
    }
    
    printf("\nEnter the number of processes: ");
    scanf("%d", &m);
    
    // Process each request using Best Fit
    for(i = 0; i < m; i++) {
        int process_id, process_size;
        
        printf("Enter Process ID: ");
        scanf("%d", &process_id);
        printf("Enter size required for Process P%d: ", process_id);
        scanf("%d", &process_size);
        
        int best_fit_block = -1;
        int best_fit_size = 9999999;
        
        // Find the block with smallest sufficient size
        for(j = 0; j < n; j++) {
            if(memory[j].allocated == 0 && memory[j].size >= process_size) {
                if(memory[j].size < best_fit_size) {
                    best_fit_block = j;
                    best_fit_size = memory[j].size;
                }
            }
        }
        
        // Allocate the best fit block
        if(best_fit_block != -1) {
            memory[best_fit_block].allocated = 1;
            memory[best_fit_block].process_id = process_id;
            printf("Process P%d allocated to Memory Block %d\n", process_id, memory[best_fit_block].id);
        } else {
            printf("Not enough memory for Process P%d\n", process_id);
        }
    }
    
    // Display memory allocation status
    printf("\nMemory Allocation Status:\n");
    printf("Block ID\tSize\tStatus\t\tProcess ID\n");
    
    for(i = 0; i < n; i++) {
        printf("%d\t\t%d\t", memory[i].id, memory[i].size);
        
        if(memory[i].allocated == 1) {
            printf("Allocated\tP%d\n", memory[i].process_id);
        } else {
            printf("Free\t\t-\n");
        }
    }
    
    // Calculate and display fragmentation
    int total_fragmentation = 0;
    
    for(i = 0; i < n; i++) {
        if(memory[i].allocated == 1) {
            // For each allocated block, find the process size
            int process_id = memory[i].process_id;
            int process_size;
            
            for(j = 0; j < m; j++) {
                // Assume we have stored process sizes
                // In real implementation, we'd need to keep this information
                // For now, we'll just use a placeholder calculation
                process_size = memory[i].size - memory[i].size / 5; // Example calculation
                total_fragmentation += (memory[i].size - process_size);
            }
        }
    }
    
    printf("\nTotal Internal Fragmentation: %d units\n", total_fragmentation);
}
