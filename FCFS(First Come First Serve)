#include<stdio.h>
#include<conio.h>

// First Come First Serve (FCFS) :
// Writing the structure for process
struct process
{
    int process_seq[100], wt[100], bt[100], tat[100], at[100], priority[100];
    int n; // For the number of processes.
};

// Setting the arrival to zero
void set_zero(struct process *p)
{
    int i;
    for(i = 0; i < p->n; i++)
        p->at[i] = 0;
}

// Writing the print function for the gantt chart
void print_gantt_chart(struct process *p)
{
    int i;
    int completion_time[100];
    
    // Calculate completion times
    completion_time[0] = p->bt[0];
    for(i = 1; i < p->n; i++) {
        completion_time[i] = completion_time[i-1] + p->bt[i];
    }
    
    // Making the basic construct for the chart
    printf("The gantt chart for the problem is as follows : \n");
    printf("\t\t");
    for (i = 0; i < p->n; i++) {   
        printf("| P%d\t ", p->process_seq[i]);
    }
    printf("|\n\t\t");
    
    // Print time markers
    printf("0");
    for(i = 0; i < p->n; i++) {
        printf("\t%d", completion_time[i]);
    }
    printf("\n");
}

// Making the FCFS scheduling function
void fcfs(struct process *p)
{
    int i;
    int total_wt = 0, total_tat = 0;
    
    // Calculate waiting time and turnaround time
    p->wt[0] = 0; // First process has 0 waiting time
    
    for(i = 1; i < p->n; i++) {
        // Waiting time = sum of all previous burst times - arrival time
        p->wt[i] = 0;
        for(int j = 0; j < i; j++) {
            p->wt[i] += p->bt[j];
        }
        p->wt[i] -= p->at[i];
        if(p->wt[i] < 0) p->wt[i] = 0; // Waiting time can't be negative
    }
    
    // Calculate turnaround time (TAT = WT + BT)
    for(i = 0; i < p->n; i++) {
        p->tat[i] = p->wt[i] + p->bt[i];
        total_wt += p->wt[i];
        total_tat += p->tat[i];
    }
    
    // Print average waiting time and turnaround time
    printf("\nAverage Waiting Time = %.2f\n", (float)total_wt / p->n);
    printf("Average Turnaround Time = %.2f\n", (float)total_tat / p->n);
}

// Making the input function which would take the necessary information
void input_details(struct process *p)
{   
    // Variable declarations
    int i, choice;
    
    // Please enter the number of processes
    printf("Enter the number of processes: ");
    scanf("%d", &p->n);
    
    // Taking the process arrival sequence
    printf("Please enter the processes sequence (1, 2, 3, etc.): \n");
    for(i = 0; i < p->n; i++) {
        scanf("%d", &p->process_seq[i]);
    }
    
    // Taking the burst times as an input
    printf("Please enter their burst times in their sequence: \n");
    for(i = 0; i < p->n; i++) {
        scanf("%d", &p->bt[i]);
    }
    
    printf("Are all of their arrival times = 0ms?\n1.yes\t2.No\n");
    scanf("%d", &choice);
    
    if(choice == 1)
        set_zero(p);
    else {
        printf("Please enter arrival times in sequence: \n");
        for(i = 0; i < p->n; i++) {
            scanf("%d", &p->at[i]);
        }
    }
    
    fcfs(p);
    print_gantt_chart(p);
}

// Writing the main function
int main()
{
    struct process p;
    input_details(&p);
    return 0;
}
