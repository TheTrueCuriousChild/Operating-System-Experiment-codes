#include <stdio.h>

// Structure to store process information
struct Process {
    int id;          // Process ID
    int arrival;     // Arrival Time
    int burst;       // Burst Time
    int waiting;     // Waiting Time
    int turnaround;  // Turnaround Time
    int completed;   // Flag to mark completion
};

void main() {
    int n, i, j;
    float avg_waiting = 0, avg_turnaround = 0;
    
    printf("Enter the number of processes: ");
    scanf("%d", &n);
    
    struct Process p[n];
    
    // Input process details
    for(i = 0; i < n; i++) {
        p[i].id = i+1;
        printf("Enter arrival time for Process P%d: ", i+1);
        scanf("%d", &p[i].arrival);
        printf("Enter burst time for Process P%d: ", i+1);
        scanf("%d", &p[i].burst);
        p[i].completed = 0;
    }
    
    int current_time = 0;
    int completed_processes = 0;
    int gantt_chart[100];  // To store the process sequence
    int gantt_time[100];   // To store the time points
    int gantt_index = 0;
    
    gantt_time[0] = 0;
    
    // Process scheduling
    while(completed_processes < n) {
        int selected_process = -1;
        int shortest_burst = 9999;
        
        // Find the process with the shortest burst time
        for(i = 0; i < n; i++) {
            if(p[i].arrival <= current_time && p[i].completed == 0) {
                if(p[i].burst < shortest_burst) {
                    shortest_burst = p[i].burst;
                    selected_process = i;
                }
            }
        }
        
        // If no process is available, advance time
        if(selected_process == -1) {
            current_time++;
            continue;
        }
        
        // Process found, calculate times
        p[selected_process].waiting = current_time - p[selected_process].arrival;
        p[selected_process].turnaround = p[selected_process].waiting + p[selected_process].burst;
        
        // Update current time
        current_time += p[selected_process].burst;
        
        // Record for Gantt chart
        gantt_chart[gantt_index] = p[selected_process].id;
        gantt_index++;
        gantt_time[gantt_index] = current_time;
        
        // Mark as completed
        p[selected_process].completed = 1;
        completed_processes++;
        
        // Update averages
        avg_waiting += p[selected_process].waiting;
        avg_turnaround += p[selected_process].turnaround;
    }
    
    // Calculate averages
    avg_waiting /= n;
    avg_turnaround /= n;
    
    // Display results
    printf("\nSJF Non-preemptive Scheduling:\n");
    printf("Process\tArrival\tBurst\tWaiting\tTurnaround\n");
    
    for(i = 0; i < n; i++) {
        printf("P%d\t%d\t%d\t%d\t%d\n", p[i].id, p[i].arrival, p[i].burst, p[i].waiting, p[i].turnaround);
    }
    
    printf("\nAverage Waiting Time: %.2f\n", avg_waiting);
    printf("Average Turnaround Time: %.2f\n", avg_turnaround);
    
    // Display Gantt Chart
    printf("\nGantt Chart:\n");
    printf("| ");
    for(i = 0; i < gantt_index; i++) {
        printf("P%d | ", gantt_chart[i]);
    }
    
    printf("\n");
    for(i = 0; i <= gantt_index; i++) {
        printf("%d    ", gantt_time[i]);
    }
    printf("\n");
}
